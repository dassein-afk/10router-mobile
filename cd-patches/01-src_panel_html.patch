+   *     · 轨道比容器还宽 → 内容必然被右切（如 free-pool-body 内联写了 minmax(420px,1fr)）
+   *     · 轨道被压到 <200px，且格子里有控件/长文 → 内容已经被压扁
+   *   无控件的短文字格子（如数字统计行）不动 —— 那不是被压扁，是本来就该并排。
+   */
+  function passStack() {
+    var list = document.querySelectorAll('body *');
+    for (var i = 0; i < list.length; i++) {
+      var el = list[i];
+      if (el.getAttribute('data-pf-stack')) continue;
+      var cs = getComputedStyle(el);
+      if (cs.display !== 'grid') continue;
+      if (cs.overflowX === 'auto' || cs.overflowX === 'scroll') continue;
+      var tracks = (cs.gridTemplateColumns || '').trim().split(/\s+/).filter(Boolean);
+      if (!tracks.length) continue;
+      var box = boxW(el);
+      if (box < 40) continue;                       // 还没布局好 —— 不标记，下轮再看（曾因先标记而永久错过）
+      var track0 = parseFloat(tracks[0]) || 0;
+      var over = track0 > box + 2;
+      var crushed = false;
+      if (tracks.length > 1 && track0 < CRUSH_MIN) {
+        for (var k = 0; k < el.children.length; k++) {
+          var c = el.children[k];
+          var hasCtl = c.querySelector && !!c.querySelector('button, a[href], input, select, textarea, [role="switch"]');
+          if (hasCtl || (c.textContent || '').trim().length > 40) { crushed = true; break; }
+        }
+      }
+      if (over || crushed) {
+        try { el.style.setProperty('grid-template-columns', 'minmax(0, 1fr)', 'important'); } catch (e) {}
+        stats.stack++;
+      }
+      el.setAttribute('data-pf-stack', '1');
+    }
+  }
+
+  function passCdLoading() {
+    var m = /[?&]p=credit/.exec(location.search || '');
+    if (!m && location.port !== '47860') return;
+    setTimeout(function () {
+      var all = document.querySelectorAll('body *');
+      for (var i = 0; i < all.length; i++) {
+        var el = all[i];
+        if (el.children.length > 4) continue;
+        var t = (el.textContent || '').trim();
+        if (t.indexOf('CreditDaddy') < 0) continue;
+        var r = el.getBoundingClientRect();
+        if (r.width < 40 || r.height < 20) continue;
+        if (r.width > window.innerWidth * 0.8) continue;
+        var cs = getComputedStyle(el);
+        if (cs.position !== 'fixed' && cs.position !== 'absolute') continue;
+        try { el.style.setProperty('display', 'none', 'important'); } catch (e) {}
+        stats.reveal++;
+        break;
+      }
+    }, 8000);
+  }
+
+  /** 11. 横向可滑的标签条 —— 能滑 ≠ 看得出能滑。
+   *  实测（360px，CD v1.5.2 仪表盘）：产品标签条 scrollWidth=912 / clientWidth=334，
+   *  9 个标签只露出 3 个，ZCode/Trae/MiniMax/网页会话/10Router 全在屏外；
+   *  安卓 WebView 的覆盖式滚动条不滚动手就不出现 → 用户直接以为这些产品不存在（功能不可达级的问题）。
+   *  只做容器级视觉暗示：滚动条常驻可见 + 右缘渐隐 + 滑到底取消渐隐。
+   *  ❗不让它换行、不改任何控件尺寸：passWrap 里"滚动条元素绝不能动"那条守卫的理由依然成立，
+   *    标签条横向滑是上游刻意设计，我们要补的是"暗示"，不是替上游改设计。 */
+  function passTabHint() {
+    var list = document.querySelectorAll('nav, div');
+    for (var i = 0; i < list.length; i++) {
+      var el = list[i];
+      if (el.getAttribute('data-pf-tab')) continue;
+      el.setAttribute('data-pf-tab', '1');
+      var cs = getComputedStyle(el);
+      if (cs.overflowX !== 'auto' && cs.overflowX !== 'scroll') continue;
+      var r = el.getBoundingClientRect();
+      if (r.width < 120 || r.height < 20 || r.height > 96) continue;          // 只管"条"，不碰大块区域
+      if (el.scrollWidth <= el.clientWidth * 1.25) continue;                  // 溢出不足 25% 不值得提示
+      var tabs = el.querySelectorAll(':scope > a, :scope > button, :scope > * > a, :scope > * > button');
+      if (tabs.length < 4) continue;                                          // 少于 4 个选项不算标签条
+      el.classList.add('pf-tabscroll');
+      var mark = function () {
+        var max = el.scrollWidth - el.clientWidth;
+        if (el.scrollLeft >= max - 4) el.classList.remove('pf-tabmore');
+        else el.classList.add('pf-tabmore');
+      };
+      try { el.addEventListener('scroll', mark, { passive: true }); }
+      catch (e) { el.addEventListener('scroll', mark); }
+      mark();
+      stats.tabhint = (stats.tabhint || 0) + 1;
+    }
+  }
+
+  /** 12. 语言按钮的国旗必须与界面实际语言一致（只修显示，绝不代用户写 cookie）。
+   *  上游 src/shared/components/HeaderLanguage.js：
+   *      getLocaleFromCookie() 在没有 locale cookie 时 return "en"
+   *  而我们的下游补丁把 DEFAULT_LOCALE 定成 zh-CN —— 于是新装机上【界面是中文、按钮是 🇺🇸、
+   *  title 还是英文 "Language"】，用户会以为自己是英文界面或语言坏了（360px 实测复现）。
+   *  判据用"实际渲染出来的文字"，不看 html lang（SSR 那份恒为 en，正是它骗人）。 */
+  function passLangFlag() {
+    if (/;\s*locale=|^\s*locale=/.test(document.cookie || '')) return;   // 用户自己选过语言 → 完全尊重上游
+    var probe = document.querySelectorAll('aside nav a, nav a, h1, h2, .material-symbols-outlined ~ span');
+    var tot = 0, zh = 0;
+    for (var i = 0; i < probe.length && tot < 40; i++) {
+      var t = (probe[i].textContent || '').trim();
+      if (!t || t.length > 24) continue;
+      tot++;
+      if (/[\u4e00-\u9fa5]/.test(t)) zh++;
+    }
+    if (tot < 6) return;                                   // 还判不出语言，别乱动
+    var btns = document.querySelectorAll('button[title="Language"], button[data-i18n-skip]');
+    for (var j = 0; j < btns.length; j++) {
+      var b = btns[j], sp = b.querySelector('span');
+      if (!sp) continue;
+      var s = (sp.textContent || '').trim();
+      var cp = s.length ? s.codePointAt(0) : 0;
+      var isFlag = s.length >= 2 && cp >= 0x1F1E6 && cp <= 0x1F1FF;
+      if (!isFlag && s !== '🌐') continue;                     // 只认国旗按钮，别误伤其它图标按钮
+      // ⚠️ 只在"真的不一样"时写：写 textContent 是 childList 变更，会被本补丁自己的
+      // MutationObserver 再抓到 —— 无条件赋值 = 无限重跑（自我触发的活锁）。
+      var want = (zh / tot >= 0.5) ? '🇨🇳' : null;
+      var wantTitle = (zh / tot >= 0.5) ? '语言：简体中文（点击切换）' : '语言（点击切换）';
+      var touched = false;
+      if (want && s !== want) { sp.textContent = want; touched = true; }
+      if (b.title !== wantTitle) { b.title = wantTitle; touched = true; }
+      if (touched) stats.langflag = (stats.langflag || 0) + 1;
+    }
+  }
+
+  /** 13. 竖排可点项的"节距"补到 44px —— 只加间距，绝不碰控件本身。
+   *  实测（360px）：10R 每个页面都有 17~33 个高度 <40px 的可点元素，几乎全在侧栏/抽屉的
+   *  竖排菜单里（上游用 py-1 → 实测 28px 高、行间 2px）。手机拇指的可靠命中区约 44px，
+   *  28px + 2px 间隙 = 连点相邻两项极易误触。
+   *  为什么不动控件高度：补丁铁律②「绝不改控件尺寸/形态」—— 曾把 32×16 的开关撑成 36×36
+   *  变成圆，同页另一种开关仍是长条，用户当场指出"他们应该保持一个形态"。
+   *  所以这里只改容器的 row-gap：把 (节距 = 项高 + 间隙) 补到 ≥44px，项本身一寸没动。
+   *  守卫：只在窄屏、只在竖排、至少 4 个同宽可点子项、且容器可滚或位于 nav/aside 内才动手。 */
+  var PITCH_MIN = 46;   // 目标节距取 46 而不是 44：margin 取整会掉 1px，实测补 14 只到 43
+  function passPitch() {
+    if (vw() > 520) return;
+    // v1.11.11：本 pass 只作用于 CreditDaddy 面板。10R 网关面板加节距后被用户实测为负优化
+    // （"文字之间看不完全"、且"房子图标与底层文字的重合本来是对的"）—— 10R 侧栏保持上游原样。
+    // 判定 CD：标题含 CreditDaddy/额度管家，或 URL 落在额度面板端口（47860 或 47xxx）。
+    var onCD = /creditdaddy|额度管家/i.test(document.title)
+            || /[:\/]47\d{3,4}[:\/]/.test(location.href);
+    if (!onCD) return;
+    var list = document.querySelectorAll('nav, aside, div');
+    for (var i = 0; i < list.length; i++) {
+      var el = list[i];
+      if (el.getAttribute('data-pf-pitch')) continue;
+      el.setAttribute('data-pf-pitch', '1');
+      var cs = getComputedStyle(el);
+      var isFlexCol = (cs.display === 'flex' && cs.flexDirection === 'column');
+      if (cs.display !== 'block' && !isFlexCol) continue;      // 只管竖排
+      // 取"参与竖排的流子项"，并识别其中的可点项（a/button，或被单层 div 包着的 a/button）
+      var rows = [];
+      for (var k = 0; k < el.children.length; k++) {
+        var c = el.children[k], ccs = getComputedStyle(c);
+        if (ccs.position === 'absolute' || ccs.position === 'fixed') continue;
+        var cr = c.getBoundingClientRect();
+        if (cr.width <= 0 || cr.height <= 0) continue;
+        var hit = (/^A$|^BUTTON$/.test(c.tagName)) ? c
+                : (c.children.length <= 2 ? c.querySelector(':scope > a, :scope > button') : null);
+        if (!hit) continue;
+        rows.push({ flow: c, hit: hit, top: cr.top, bottom: cr.bottom, h: cr.height, w: cr.width });
+      }
+      if (rows.length < 4) continue;
+      var h0 = rows[0].h, w0 = rows[0].w;
+      if (h0 <= 0 || h0 >= PITCH_MIN) continue;                 // 本来就够高，别管
+      var uniform = true;
+      for (var m = 1; m < rows.length; m++) {                   // 只处理"同宽同高的重复菜单项"，避免误伤工具条
+        if (Math.abs(rows[m].w - w0) > 14 || Math.abs(rows[m].h - h0) > 8) { uniform = false; break; }
+      }
+      if (!uniform) continue;
+      var fixed = 0;
+      for (var p = 1; p < rows.length; p++) {
+        var pitch = rows[p].top - rows[p - 1].top;             // 节距 = 相邻两项顶边之差（项高 + 间隙）
+        var need = PITCH_MIN - pitch;
+        if (need <= 1) continue;
+        try {
+          if (isFlexCol) {                                      // flex：加在容器 gap 上（一次到位）
+            el.style.setProperty('row-gap', (parseFloat(cs.rowGap) || 0) + need + 'px', 'important');
+            break;                                              // flex 的 gap 对全组生效，不必逐个子项
+          }
+          // block（上游用 space-y-* = 子项 margin-top）：只能逐个子项补差值
+          var fm = getComputedStyle(rows[p].flow).marginTop;
+          var cur = parseFloat(fm) || 0;
+          rows[p].flow.style.setProperty('margin-top', Math.round(cur + need) + 'px', 'important');
+          fixed++;
+        } catch (e) { break; }
+      }
+      if (fixed || isFlexCol) stats.pitch = (stats.pitch || 0) + 1;
+    }
+  }
+
+  /* 网关面板：只放行两条产品规则（隧道入口隐藏 / 面板内更新按钮隐藏），
+     其余排版类 pass 全部不跑 —— 用户指令"网关的补丁只保留侧栏颜色"。
+  /* 无开关：这份脚本随 CD 源码走，永远生效。 */
+  function off(name) { return false; }
+
+  function run() {
+    try { if (!off('pad')) passStack(); } catch (e) {}
+    try { if (!off('width')) passWidth(); } catch (e) {}
+    try { if (!off('wrap')) passWrap(); } catch (e) {}
+    try { if (!off('reveal')) passReveal(); } catch (e) {}
+    try { if (!off('unclip')) passUnclip(); } catch (e) {}
+    try { if (!off('contrast')) passContrast(); } catch (e) {}
+    try { if (!off('scroll')) passScroll(); } catch (e) {}
+    try { if (!off('cdLoading')) passCdLoading(); } catch (e) {}
+    try { if (!off('tabhint')) passTabHint(); } catch (e) {}
+    try { if (!off('langflag')) passLangFlag(); } catch (e) {}
+    try { if (!off('pitch')) passPitch(); } catch (e) {}
+    window.__panelFixRuns = (window.__panelFixRuns || 0) + 1;
+    window.__panelFixLastAt = Date.now();
+
+    /* 告知原生"适配已生效、可以露出页面了"（壳据此揭开加载遮罩）。
+       只在页面已经有真内容时报 —— 骨架屏阶段就报等于把空白页揭给用户看。
+       浏览器里（没有 Native）静默跳过；报一次就不再重复，避免每轮 Mutation 都跨语言通信。 */
+    if (!window.__panelFixTold && window.Native && window.Native.patchApplied) {
+      try {
+        var b = document.body;
+        if (b && b.querySelectorAll('*').length >= 60 && (b.innerText || '').replace(/\s+/g, '').length >= 120) {
+          window.__panelFixTold = true;
+          window.Native.patchApplied();
+        }
+      } catch (e) {}
+    }
+  }
+  window.__panelFixRun = run;
+
+  var timer = null;
+  function schedule() { if (timer) clearTimeout(timer); timer = setTimeout(run, 120); }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
+  else run();
+  window.addEventListener('resize', schedule);
+  window.addEventListener('orientationchange', schedule);
+  setTimeout(run, 400);
+  setTimeout(run, 1200);
+  try { new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true }); } catch (e) {}
+
+  /* v1.11.11：SPA 路由切换后内容分片挂载，单次 run 常在布局完成前量错（clientHeight/scrollHeight
+     不准）→ 关键按钮的 reveal/unclip 没生效 = 用户说的"时灵时不灵"。
+     做法：监听 popstate，并周期性比对 location.href；一旦变化，错峰重跑 run（200/600/1500/3000ms）
+     覆盖分片挂载的尾段。不靠路由框架，纯 URL 比对，对所有上游都安全。 */
+  var _lastHref = location.href;
+  function onRouteMaybe() {
+    if (location.href === _lastHref) return;
+    _lastHref = location.href;
+    [200, 600, 1500, 3000].forEach(function (d) { setTimeout(run, d); });
+  }
+  window.addEventListener('popstate', onRouteMaybe);
+  window.addEventListener('hashchange', onRouteMaybe);
+  setInterval(onRouteMaybe, 700);
+})();
+
+</script>
 </body>
 </html>
 

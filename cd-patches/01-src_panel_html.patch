+
+  /* ============================================================
+     手机适配 —— 纯 CSS（源码级）
+
+     历史：这一层原先是运行时注入的 panel-fix.js，靠 JS 扫 DOM 量宽度再改。
+     那种做法的代价是可复现的：扫漏一个元素就整页错乱；给元素加类再靠类生效，
+     类没生效就完全没有提示（标签栏滑到末尾一片空白就是这么来的）；
+     而且它永远慢一拍——页面已经画出来才动手，用户能看见跳变。
+
+     现在全部落在 CSS 上，只写规则，不量不猜不加类。
+     红线（每条都是踩过的坑）：
+       ① 不改字号  ② 不改控件尺寸/形态  ③ 不因屏窄把并排改成多列
+       ④ 只约束"内容不越界 / 能断行 / 能滑"，不重排布局
+     ============================================================ */
+
+  /* --- 媒体与嵌入元素永远不超过容器 --- */
+  img, svg, video, canvas, iframe { max-width: 100%; }
+  img, video { height: auto; }
+
+  /* --- 长字符串（密钥 / URL / 模型名 / 路径）必须能断行 --- */
+  code, pre, kbd, samp, .mono { overflow-wrap: anywhere; }
+
+  /* --- 根节点不横向撑破（只约束自身，不隐藏任何内容）--- */
+  html, body { max-width: 100%; overflow-x: hidden; }
+
+  /* --- 顶部标签栏：手机上横向滚动，并让"还能滑"一眼可见 ---
+     旧做法是在运行时给容器加类再靠类生效，类没生效就完全没有提示，
+     滑到末尾看起来就是一片空白。这里直接写成常驻规则：
+     细滚动条 + 右缘渐隐，不依赖任何类、不依赖 JS。 */
+  .nav {
+    -webkit-overflow-scrolling: touch;
+    scrollbar-width: thin;
+    overscroll-behavior-x: contain;
+    /* 右缘渐隐：告诉用户右边还有内容。不支持 mask 的内核下退化为普通滚动，不报错。 */
+    -webkit-mask-image: linear-gradient(90deg, #000 0, #000 calc(100% - 18px), rgba(0,0,0,.45) 100%);
+    mask-image: linear-gradient(90deg, #000 0, #000 calc(100% - 18px), rgba(0,0,0,.45) 100%);
+  }
+  .nav::-webkit-scrollbar { height: 3px; display: block; }
+  .nav::-webkit-scrollbar-thumb { background: rgba(128,128,128,.55); border-radius: 99px; }
+  .nav::-webkit-scrollbar-track { background: transparent; }
+
+  /* --- 结构性截断：内容比容器大却没给滚动条 → 改成可滚动 --- */
+  .list, .cards, .grid, .row, table { max-width: 100%; }
+
+  /* --- 单行省略号在窄屏上改成换行，避免"后半句摸不到" ---
+     只对可能很长的描述行生效，不碰按钮与标签（它们靠 nowrap 保持一行）。 */
+  .desc, .note, .sub, .hint, p, small {
+    overflow-wrap: anywhere;
+    word-break: break-word;
+  }
+
+  /* --- 弹性子项默认 min-width:auto 会被内容撑破，统一放到 0 --- */
+  .row > *, .flex > * { min-width: 0; }
+
+  /* --- 手机上输入框字号 < 16px 时聚焦会自动放大整页（行为约束，不是审美）--- */
+  @media (max-width: 560px) {
+    input, select, textarea { font-size: max(16px, 1em); }
+    /* 全屏弹窗：宽度按容器流变，任何宽度下都不出屏 */
+    [role="dialog"], .modal, .mask > .box { max-width: 94vw; max-height: 88vh; overflow: auto; }
+  }
+
+  /* --- 面板设置浮层：定位锚点抬到整行，右对齐观感不变，左缘永远在屏内 ---
+     原规则锚在齿轮按钮上（right:0 相对 28px 的按钮），而按钮右边还有别的图标，
+     实测 360px 视口下 left=-26，左侧 26px 在屏外。 */
+  .head-right { position: relative; }
+  .head-right .head-setpop { position: static; }
 </style>
